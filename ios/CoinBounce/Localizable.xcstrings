{
  "sourceLanguage": "en",
  "strings": {
    "%lld Free Spins": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "免费转 %lld 次"
          }
        }
      }
    },
    "%lld spins left": {
      "localizations": {
        "en": {
          "variations": {
            "plural": {
              "one": {
                "stringUnit": {
                  "state": "translated",
                  "value": "%lld spin left"
                }
              },
              "other": {
                "stringUnit": {
                  "state": "translated",
                  "value": "%lld spins left"
                }
              }
            }
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "还要转 %lld 次"
          }
        }
      }
    },
    "+%lld Coins": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "+%lld 金币"
          }
        }
      }
    },
    "A coin passing through the BONUS slider spins the slot machine. Three or more matching symbols in the middle row win coins; a full row is the JACKPOT.": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "金币从 BONUS 滑块中间穿过会启动老虎机。中间一行连续 3 个以上相同符号赢金币，整行相同就是 JACKPOT。"
          }
        }
      }
    },
    "A coin passing through the middle of a fruit lights it. Light all 7 fruits to pick a reward card, then the fruits reset.": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "金币从水果灯中间穿过会点亮它。7 个水果全部点亮后可以选一张奖励卡，然后水果全部熄灭，开始新一轮。"
          }
        }
      }
    },
    "Ad Privacy Options": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "广告隐私选项"
          }
        }
      }
    },
    "Added to your balance": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "直接加入余额"
          }
        }
      }
    },
    "All fruits lit! Pick a card": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "水果全亮！选一张卡"
          }
        }
      }
    },
    "BLAZING! x%lld": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "燃爆！x%lld"
          }
        }
      }
    },
    "BOSS loses %lld%% HP": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "BOSS 立即掉 %lld%% 血"
          }
        }
      }
    },
    "Bunny": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "兔女郎"
          }
        }
      }
    },
    "COMBO! x3": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "连击！x3"
          }
        }
      }
    },
    "Coins are virtual and have no real-world value.": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "金币是虚拟的，没有现实价值。"
          }
        }
      }
    },
    "Coins fall from the slider at the top, bounce through the slot machine, the battle and the fruit row, then land on the pusher.": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "金币从顶部滑块落下，弹跳着穿过老虎机、战斗区和水果灯排，最后落到推币台上。"
          }
        }
      }
    },
    "Done": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "完成"
          }
        }
      }
    },

{
  "sourceLanguage": "en",
  "strings": {
    "%@: I won %lld coins 🪙 Can you beat it?": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%@：我赢了 %lld 枚金币 🪙 你能超过吗？"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "%@：我贏了 %lld 枚金幣 🪙 你能超過嗎？"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%@：メダル %lld 枚ゲット 🪙 超えられる？"
          }
        }
      }
    },
    "%lld Free Spins": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {

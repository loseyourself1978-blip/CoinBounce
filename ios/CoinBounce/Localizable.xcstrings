          }
        }
      }
    },
    "Pick one of three machines. Set your bet and tap SPIN. Matching symbols on any of 10 lines, starting from the left reel, win a multiple of your bet.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "三台机器任选一台。调好下注，点 SPIN。10 条中奖线上从最左一列开始连成相同图案，就赢下注的若干倍。"

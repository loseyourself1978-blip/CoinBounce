{
  "sourceLanguage": "en",
  "strings": {
    "%lld Free Spins": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "免费转 %lld 次"
          }
        }
      }
    },
    "%lld ROUNDS": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld 回合"
          }
        }
      }
    },
    "%lld in a row!": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld 连庄！"
          }
        }
      }
    },
    "%lld spins left": {
      "localizations": {
        "en": {
          "variations": {
            "plural": {
              "one": {
                "stringUnit": {
                  "state": "translated",
                  "value": "%lld spin left"
                }
              },
              "other": {
                "stringUnit": {
                  "state": "translated",
                  "value": "%lld spins left"
                }
              }
            }
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "还要转 %lld 次"
          }
        }
      }
    },
    "+%lld Coins": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "+%lld 金币"
          }
        }
      }
    },
    "10 fixed lines pay from the leftmost reel. Every win is a multiple of your total bet. Expected return is about 94%. Coins are virtual and have no real-world value.": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "10 条固定中奖线，从最左边一列开始连。每次中奖都是总下注的整数倍。期望返还约 94%。金币是虚拟的，没有现实价值。"
          }
        }
      }
    },
    "10 fixed lines pay from the leftmost reel. Every win is a multiple of your total bet. Expected return is about 95%. Coins are virtual and have no real-world value.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "10 条固定中奖线，从最左边一列开始连。所有中奖都是总下注的倍数。期望返还率约 95%。金币是虚拟的，没有任何现实价值。"
          }
        }
      }
    },
    "10 lines · wins pay ×bet": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "10 条线 · 中奖按总下注的倍数赔"
          }
        }
      }
    },
    "3 CHESTS": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "3 个宝箱"
          }
        }
      }
    },
    "3 OR MORE": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "3 个以上"
          }
        }
      }
    },
    "5 IN A ROW": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "五连"
          }
        }
      }
    },
    "5 REELS · 10 LINES": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "5 列转轮 · 10 条中奖线"
          }
        }
      }
    },
    "6 coins start Hold & Respin": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "出 6 枚金币开始锁定重转"
          }
        }
      }
    },
    "A ball lost in the first 7 seconds is returned once for free. Return depends on skill: about 50% without flipping, about 95% for average play.": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "开球 7 秒内掉下去的球免费还一次。返还率看技术：不打挡板约 50%，普通水平约 95%。"
          }
        }
      }
    },
    "A coin passing through the BONUS slider spins the slot machine. Three or more matching symbols in the middle row, starting from the left, win coins; a full row is the JACKPOT.": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "金币穿过 BONUS 滑块会转动老虎机。中间一行从最左边起连续 3 个及以上相同符号赢金币，整行相同就是 JACKPOT。"
          }
        }
      }
    },
    "A coin passing through the middle of a fruit lights it. Light all 7 fruits to pick a reward card, then the fruits reset.": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "金币从水果灯中间穿过会点亮它。7 个水果全部点亮后可以选一张奖励卡，然后水果全部熄灭，开始新一轮。"
          }
        }
      }
    },
    "A little gift for you. Come back in 4 hours for more!": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "送你一点小礼物，4 小时后再来领哦！"
          }
        }
      }
    },
    "A single number pays 35 to 1. A dozen or a column pays 2 to 1. Red or black, odd or even, 1–18 or 19–36 pay 1 to 1. Zero wins only for a bet on 0.": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "单个号码赔 35 倍。一打或一列赔 2 倍。红黑、单双、1–18 / 19–36 赔 1 倍。开出 0 时只有押 0 的赢。"
          }
        }
      }
    },
    "ALL STARS LIT!": {
      "extractionState": "manual",
      "localizations": {

          }
        }
      }
    },
    "Pockets: the center start pocket pays 1 and spins the reels. Tulips pay 2 and open or close each time. Side pockets pay 1. The lucky cup sliding along the bottom pays 2.": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "入口：中间的始动口赔 1 币并转一次数字盘。郁金香赔 2 币，每进一球开合一次。两侧袖口赔 1 币。底部来回滑动的幸运杯赔 2 币。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "入口：中間的始動口賠 1 幣並轉一次數字盤。鬱金香賠 2 幣，每進一球開合一次。兩側袖口賠 1 幣。底部來回滑動的幸運杯賠 2 幣。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "入賞口：中央のスタートチャッカーは 1 枚でリールが回ります。チューリップは 2 枚で、入るたびに開閉。左右の袖は 1 枚。下を往復するラッキーカップは 2 枚。"
          }
        }
      }
    },
    "Power": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "力度"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",

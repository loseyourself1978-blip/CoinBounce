        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "点击 $ 按钮投一枚金币，按住不放可以连续投币。"
          }
        }
      }
    },
    "The pusher moves back and forth. Coins pushed off the front edge are yours.": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {

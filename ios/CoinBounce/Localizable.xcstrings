          }
        }
      }
    },
    "Warrior": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "勇士"
          }
        }
      }
    },
    "Warrior Strike": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "勇士重击"
          }
        }
      }
    },
    "Watch ad": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "看广告"
          }
        }
      }
    },
    "Watch an ad for %lld free coins": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "看广告免费领 %lld 金币"
          }
        }
      }
    },
    "Tap ▶ +50 at the top to watch a short ad for 50 coins, once every 90 seconds, up to 10 times a day.": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "点顶部的 ▶ +50 看一段短广告领 50 金币，每 90 秒一次，每天最多 10 次。"
          }
        }
      }
    },
    "Each coin pushed off the front edge pays 1 coin. Coins that slide off the sides are lost.": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "从前沿推落的每枚金币得 1 枚；从两侧滑落的不算。"
          }
        }
      }
    },
    "Coins crossing the battle hit the BOSS. Knock it out for 5 coins.": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "金币穿过战斗区会攻击 BOSS，打倒它得 5 金币。"
          }
        }
      }
    },
    "Glowing coins are special: each one pushed off pays 2 coins.": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "发光的是特殊金币：每推落一枚得 2 金币。"
          }
        }
      }
    }
  },
  "version": "1.0"
}

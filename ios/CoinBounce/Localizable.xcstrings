    "Tap the $ button to drop a coin. Hold it to keep dropping.": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "点击 $ 按钮投一枚金币，按住不放可以连续投币。"
          }
        }
      }
    },
    "The pusher moves back and forth. Coins pushed off the front edge are yours.": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "推板前后往复，被推出前沿掉下去的金币都归你。"
          }
        }
      }
    },
    "The slot spins %lld times for free": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "老虎机免费转 %lld 次"
          }

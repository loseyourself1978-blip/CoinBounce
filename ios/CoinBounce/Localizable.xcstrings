    "Wild: replaces any fruit, gem, crown or 7 on a line. Appears on reels 2, 3 and 4.": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "百搭：在中奖线上可以当任何水果、宝石、皇冠或 7。只出现在第 2、3、4 列。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "百搭：在中獎線上可以當任何水果、寶石、皇冠或 7。只出現在第 2、3、4 列。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ワイルド：ライン上のフルーツ・宝石・王冠・7 の代わりになります。2・3・4 列目にだけ出ます。"
          }
        }
      }
    },
    "Wild: replaces any symbol on a line. Appears on reels 2, 3 and 4.": {

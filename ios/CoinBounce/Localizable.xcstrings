{
  "sourceLanguage": "en",
  "strings": {
    "+100 Coins": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "+100 金币"
          }
        }
      }
    },
    "+200 Coins": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "+200 金币"
          }
        }
      }
    },
    "2 fruits start lit": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "新一轮预先点亮 2 个水果"
          }
        }
      }
    },
    "3 Free Spins": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "免费转 3 次"
          }
        }
      }
    },
    "A coin passing through the BONUS slider spins the slot machine. Three or more matching symbols in the middle row win coins; a full row is the JACKPOT.": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "金币从 BONUS 滑块中间穿过会启动老虎机。中间一行连续 3 个以上相同符号赢金币，整行相同就是 JACKPOT。"
          }
        }
      }
    },
    "A coin passing through the middle of a fruit lights it. Light all 7 fruits to pick a reward card, then the fruits reset.": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "金币从水果灯中间穿过会点亮它。7 个水果全部点亮后可以选一张奖励卡，然后水果全部熄灭，开始新一轮。"
          }
        }
      }
    },
    "Ad Privacy Options": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "广告隐私选项"
          }
        }
      }
    },
    "Added to your balance": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "直接加入余额"
          }
        }
      }
    },
    "All fruits lit! Pick a card": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "水果全亮！选一张卡"
          }
        }
      }
    },
    "BLAZING! x%lld": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "燃爆！x%lld"
          }
        }
      }
    },
    "COMBO! x3": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "连击！x3"
          }
        }
      }
    },
    "COMMON": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "普通"
          }
        }
      }
    },
    "Coins are virtual and have no real-world value.": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "金币是虚拟的，没有现实价值。"
          }
        }
      }
    },
    "Coins crossing the battle hit the BOSS. Knock it out for 20 coins.": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "金币穿过战斗区会攻击 BOSS，打倒它奖励 20 枚金币。"
          }
        }
      }
    },
    "Coins fall from the slider at the top, bounce through the slot machine, the battle and the fruit row, then land on the pusher.": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "金币从顶部滑块落下，弹跳着穿过老虎机、战斗区和水果灯排，最后落到推币台上。"
          }
        }
      }
    },
    "Coins slide off easier for 30s": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "30 秒内金币更容易掉落"
          }
        }
      }
    },
    "Done": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "完成"

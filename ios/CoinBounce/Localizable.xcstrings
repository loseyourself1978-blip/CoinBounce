    "Six or more coins lock in place and start Hold & Respin. Fill all 15 spaces to win the GRAND jackpot.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "一次出现 6 枚以上金币会锁在原位，开始锁定重转。15 格全满赢 GRAND 大奖。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",

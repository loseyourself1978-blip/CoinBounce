            "value": "あと %lld 回転"
          }
        }
      }
    },
    "+%lld Coins": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "+%lld 金币"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "+%lld 金幣"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "+%lld メダル"
          }
        }
      }
    },
    "10 fixed lines pay from the leftmost reel. Every win is a multiple of your total bet. Expected return is about 94%. Coins are virtual and have no real-world value.": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "10 条固定中奖线，从最左边一列开始连。每次中奖都是总下注的整数倍。期望返还约 94%。金币是虚拟的，没有现实价值。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "10 條固定中獎線，從最左邊一列開始連。每次中獎都是總下注的整數倍。期望返還約 94%。金幣是虛擬的，沒有現實價值。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "10 本の固定ラインで、左端のリールからそろうと当たり。配当はすべて合計ベットの倍数です。期待還元率は約 94%。メダルは仮想のもので、現実の価値はありません。"
          }
        }
      }
    },
    "10 fixed lines pay from the leftmost reel. Every win is a multiple of your total bet. Expected return is about 95%. Coins are virtual and have no real-world value.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "10 条固定中奖线，从最左边一列开始连。所有中奖都是总下注的倍数。期望返还率约 95%。金币是虚拟的，没有任何现实价值。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "10 條固定中獎線，從最左邊一列開始連。所有中獎都是總下注的倍數。期望返還率約 95%。金幣是虛擬的，沒有任何現實價值。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "10 本の固定ラインで、左端のリールからそろうと当たり。配当はすべて合計ベットの倍数です。期待還元率は約 95%。メダルは仮想のもので、現実の価値はありません。"
          }
        }
      }
    },
    "10 lines · wins pay ×bet": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "10 条线 · 中奖按总下注的倍数赔"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "10 條線 · 中獎按總下注的倍數賠"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "10 ライン・配当はベットの倍数"
          }
        }
      }
    },

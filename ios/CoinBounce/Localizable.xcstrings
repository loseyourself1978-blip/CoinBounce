    "Each coin pushed off the front edge pays 1 coin. Coins that slide off the sides are lost.": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "从前沿推落的每枚金币得 1 枚；从两侧滑落的不算。"
          }
        }
      }
    },
    "Every prize falls from the top as real coins. They are yours once they drop off the front edge.": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "所有奖励都变成真的金币从顶部落下，从前沿掉下来才算你的。"
          }
        }
      }
    },

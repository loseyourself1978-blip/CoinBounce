    "5 REELS · 10 LINES": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "5 列转轮 · 10 条中奖线"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "5 列轉輪 · 10 條中獎線"
          }
        },
